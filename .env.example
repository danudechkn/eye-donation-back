# MOPH Eye Donation API Configuration
# กำหนด MOPH_TEST_MODE=true เพื่อจำลองการส่งข้อมูล (สำหรับทดสอบ ไม่ยิงไป MOPH จริง)
# กำหนด MOPH_TEST_MODE=false เมื่อพร้อมส่งข้อมูลไปยังระบบจริง
MOPH_TEST_MODE=true
MOPH_API_URL=https://death-reg.moph.go.th/api/eye-donations
MOPH_API_TOKEN=
HOSPITAL_CODE=10664
HOSPITAL_NAME=โรงพยาบาลปกเกล้า
